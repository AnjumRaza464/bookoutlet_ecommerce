# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection — used by Prisma migrations. Same URL without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Public URL of the site (used for SEO, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Initial admin (created by `npm run db:seed`) ─────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
ADMIN_NAME="BNB Admin"

# ── Easypaisa merchant API (online payments) ─────────────────────────────────
# Leave blank until Easypaisa issues merchant credentials; the store then offers
# manual Easypaisa transfer and Cash on Delivery only.
EASYPAISA_ENV="sandbox"            # sandbox | production
EASYPAISA_STORE_ID=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""           # merchant account number used by inquire-transaction
EASYPAISA_API_BASE_URL=""          # optional override, e.g. https://easypay.easypaisa.com.pk/easypay-service/rest
EASYPAISA_IPN_SECRET=""            # random string; IPN URL = /api/payments/easypaisa/ipn?key=<this>

# ── Manual Easypaisa transfer details shown to customers ─────────────────────
MANUAL_EASYPAISA_ACCOUNT_NUMBER="03XXXXXXXXX"
MANUAL_EASYPAISA_ACCOUNT_TITLE="BNB Book Outlet"

# Optional: extra hosts allowed for book cover images (comma-separated)
IMAGE_HOSTS=""
